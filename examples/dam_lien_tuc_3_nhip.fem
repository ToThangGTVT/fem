FEM2D 1
# Đơn vị: kN, m, °C. Chỉ số đánh từ 1.
TITLE "Dầm liên tục 3 nhịp 5 + 6 + 5 m — hoạt tải cách nhịp, biểu đồ bao"
PLANE STRESS

# MATERIAL tên E nu alpha gamma
MATERIAL "Bê tông B25" 30000000 0.2 1e-05 25
# SECTION tên A I h
SECTION "CN 30x60" 0.18 0.0054 0.6

# NODE x y
NODE 0 0
NODE 5 0
NODE 11 0
NODE 16 0

# TRUSS n1 n2 mat sec | FRAME n1 n2 mat sec khớp_i khớp_j kf [kG chỉ_nén] | TRI3 n1 n2 n3 mat t | QUAD4 n1..n4 mat t im
FRAME 1 2 1 1 0 0 0
FRAME 2 3 1 1 0 0 0
FRAME 3 4 1 1 0 0 0

# SUPPORT nút khóa_x khóa_y khóa_φ kx ky kφ
SUPPORT 1 1 1 0 0 0 0
SUPPORT 2 0 1 0 0 0 0
SUPPORT 3 0 1 0 0 0 0
SUPPORT 4 0 1 0 0 0 0

# LOADCASE tên hệ_số_TLBT loại(0 thường xuyên, 1 tạm thời) nhóm_loại_trừ γf
#   NLOAD nút Fx Fy Mz
#   ELOAD pt DIST hướng q1 q2 chiếu | POINT hướng P a | MOMENT M a | TEMP t Δt | FIT ΔL
#   DISP nút UX|UY|RZ giá_trị   (hướng: LX LY GX GY)
LOADCASE "Tĩnh tải" 1 0 0 1
  ELOAD 1 DIST GY -20 -20 0
  ELOAD 2 DIST GY -20 -20 0
  ELOAD 3 DIST GY -20 -20 0
LOADCASE "Hoạt tải nhịp 1 + 3" 0 1 1 1
  ELOAD 1 DIST GY -15 -15 0
  ELOAD 3 DIST GY -15 -15 0
LOADCASE "Hoạt tải nhịp 2" 0 1 1 1
  ELOAD 2 DIST GY -15 -15 0
  ELOAD 2 POINT GY -50 3
LOADCASE "Hoạt tải nhịp 1 + 2" 0 1 1 1
  ELOAD 1 DIST GY -15 -15 0
  ELOAD 2 DIST GY -15 -15 0
LOADCASE "Hoạt tải nhịp 2 + 3" 0 1 1 1
  ELOAD 2 DIST GY -15 -15 0
  ELOAD 3 DIST GY -15 -15 0

# COMBO tên trường_hợp hệ_số ...
COMBO "1,1TT + 1,2·Hoạt tải nhịp 1 + 3" 1 1.1 2 1.2
COMBO "1,1TT + 1,2·Hoạt tải nhịp 2" 1 1.1 3 1.2
COMBO "1,1TT + 1,2·Hoạt tải nhịp 1 + 2" 1 1.1 4 1.2
COMBO "1,1TT + 1,2·Hoạt tải nhịp 2 + 3" 1 1.1 5 1.2
